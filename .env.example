# OnceButler Discord Bot Configuration

# Discord Bot Token (required)
# Get from https://discord.com/developers/applications
DISCORD_TOKEN=your_bot_token_here

# Discord Application Client ID (required)
# Found in your Discord application settings
DISCORD_CLIENT_ID=your_client_id_here

# Gemini Image Generation Model (optional)
# Options: gemini-3.1-flash-image, gemini-2.5-flash-image, gemini-3-pro-image
# Default: gemini-3.1-flash-image (Nano Banana 2 - newest, fastest)
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
